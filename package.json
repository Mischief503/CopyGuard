{
  "name": "copyguard",
  "version": "4.42.0",
  "description": "CopyGuard Phase 30 \u2014 atomic persistence, integrity audit, verified backup and recovery engine",
  "main": "src/main.js",
  "author": "CopyGuard",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "validate": "node scripts/validate.js",
    "test": "npm run validate",
    "dist": "npm run validate && electron-builder --publish never",
    "dist:win": "npm run validate && electron-builder --win --publish never",
    "dist:mac": "npm run validate && electron-builder --mac --publish never",
    "dist:linux": "npm run validate && electron-builder --linux --publish never"
  },
  "dependencies": {
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "app.copyguard.browser",
    "productName": "CopyGuard",
    "copyright": "CopyGuard",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "CopyGuard",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CopyGuard",
      "include": "assets/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.finance",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "CopyGuard",
      "icon": "assets/icon.icns",
      "background": "assets/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 185,
          "type": "file"
        },
        {
          "x": 390,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Finance",
      "maintainer": "CopyGuard"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=20"
  }
}
